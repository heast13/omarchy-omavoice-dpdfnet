#!/usr/bin/env bash
# Print a one-line JSON probe the QML service can parse without jq in-process.
set -euo pipefail

have_dpdfnet=false

# Must match omavoice-run: the local copy, else HushMic's system install.
dp_local="${XDG_DATA_HOME:-$HOME/.local/share}/omavoice/dpdfnet"
if [[ -f $dp_local/libdpdfnet_ladspa.so && -f $dp_local/dpdfnet8_48khz_hr.onnx && -f $dp_local/libonnxruntime.so ]]; then
  have_dpdfnet=true
fi
for candidate in /usr/lib/ladspa/libdpdfnet_ladspa.so /usr/lib64/ladspa/libdpdfnet_ladspa.so; do
  [[ -f $candidate && -f /usr/share/hushmic/models/dpdfnet8_48khz_hr.onnx ]] && have_dpdfnet=true && break
done

printf '{"dpdfnet":%s}\n' "$have_dpdfnet"
