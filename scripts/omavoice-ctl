#!/usr/bin/env bash
# Live Props on omavoice.capture.
set -euo pipefail

usage() {
  echo "Usage: omavoice-ctl set [--id N] [KEY VALUE ...]" >&2
  exit 2
}

cmd=${1:-}
[[ -n $cmd ]] || usage
shift

[[ $cmd == set ]] || usage

node_id() {
  local name=$1
  # pw-cli ls prefixes the id line with a tab: "\tid 80, type ..."
  pw-cli ls Node 2>/dev/null | awk -v want="$name" '
    match($0, /id [0-9]+,/) { id = substr($0, RSTART + 3, RLENGTH - 4) }
    index($0, "node.name = \"" want "\"") { print id; exit }
  '
}

allowed_key() {
  case $1 in
    "preamp:Gain 1"|"outgain:Gain 1"|"hp:Freq"|"eq_body:Gain"|"eq_pres:Gain"|"eq_air:Gain") return 0 ;;
    "denoise:Attenuation Limit (dB)") return 0 ;;
    "deess:enabled"|"deess:thresh"|"deess:ratio") return 0 ;;
    *) return 1 ;;
  esac
}

id=""
if [[ ${1:-} == --id ]]; then
  id=${2:-}
  shift 2
  [[ $id =~ ^[0-9]+$ ]] || usage
fi

if [[ -z $id ]]; then
  id=$(node_id "omavoice.capture")
  if [[ -z $id ]]; then
    id=$(node_id "omavoice")
  fi
fi
[[ -n $id ]] || exit 1
[[ $# -gt 0 ]] || exit 0
(( $# % 2 == 0 )) || usage

params=""
numeric='^[0-9eE.+-]+$'
while [[ $# -gt 0 ]]; do
  allowed_key "$1" || usage
  [[ $2 =~ $numeric ]] || usage
  params+=" \"$1\" $2"
  shift 2
done

exec pw-cli s "$id" Props "{ params = [$params ] }"
