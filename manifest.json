{
  "schemaVersion": 1,
  "id": "gigasolo.omavoice",
  "name": "Omavoice",
  "version": "0.3.2-dpdfnet.2",
  "author": "GigaSolo",
  "license": "MIT",
  "homepage": "https://github.com/gigasolo/omavoice",
  "description": "A DPDFNet virtual microphone for OBS and recording. Podcast / Clean and Voice looks.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Omavoice",
    "description": "Virtual mic with DPDFNet noise suppression. Podcast / Clean and Voice looks.",
    "category": "Audio",
    "aliases": [
      "omavoice",
      "noise",
      "microphone",
      "voice"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "preset": "podcast",
      "pinnedSource": "",
      "previousAudioSource": "",
      "setDefaultSource": true,
      "podcastQuality": "better",
      "podcastEq": "clear",
      "podcastEqBodyDb": 0,
      "podcastEqPresenceDb": 0,
      "podcastEqAirDb": 0,
      "outputGainDb": 0,
      "captureGainDb": 0
    },
    "schema": [
      {
        "key": "enabled",
        "type": "boolean",
        "label": "Omavoice on",
        "defaultValue": true
      },
      {
        "key": "preset",
        "type": "enum",
        "label": "Preset",
        "options": [
          "podcast",
          "clean"
        ],
        "defaultValue": "podcast"
      },
      {
        "key": "pinnedSource",
        "type": "string",
        "label": "Pinned source node name",
        "description": "Empty means auto: prefer a USB capture, otherwise the default mic.",
        "defaultValue": ""
      },
      {
        "key": "previousAudioSource",
        "type": "string",
        "label": "Last real capture before Omavoice",
        "description": "Used by Auto when the default source is already omavoice. Not a pin.",
        "defaultValue": ""
      },
      {
        "key": "setDefaultSource",
        "type": "boolean",
        "label": "Make Omavoice the default input",
        "defaultValue": true
      },
      {
        "key": "podcastQuality",
        "type": "enum",
        "label": "Denoise: Softer, Balanced, or Stronger",
        "options": [
          "good",
          "better",
          "best"
        ],
        "defaultValue": "better"
      },
      {
        "key": "podcastEq",
        "type": "enum",
        "label": "Podcast voice look",
        "options": [
          "neutral",
          "warm",
          "clear",
          "bright"
        ],
        "defaultValue": "clear"
      },
      {
        "key": "podcastEqBodyDb",
        "type": "number",
        "label": "Podcast body trim (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "podcastEqPresenceDb",
        "type": "number",
        "label": "Podcast presence trim (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "podcastEqAirDb",
        "type": "number",
        "label": "Podcast air trim (dB)",
        "min": -6,
        "max": 6,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "outputGainDb",
        "type": "number",
        "label": "Output gain (dB)",
        "min": -12,
        "max": 12,
        "step": 0.5,
        "defaultValue": 0
      },
      {
        "key": "captureGainDb",
        "type": "number",
        "label": "Input gain (dB)",
        "min": -12,
        "max": 12,
        "step": 0.5,
        "defaultValue": 0
      }
    ]
  }
}
